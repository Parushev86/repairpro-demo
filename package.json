{
  "name": "repairpro",
  "version": "1.0.0",
  "description": "RepairPro - Сервизна CRM система",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build && electron-builder",
    "vite": "vite",
    "electron": "electron .",
    "start": "electron ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xlsx": "^0.18.5",
    "qrcode": "^1.5.3",
    "nodemailer": "^6.9.8",
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "bg.repairpro.app",
    "productName": "RepairPro",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": ["bg"],
      "language": "1026"
    },
    "files": ["dist/**/*", "electron/**/*", "src/**/*"],
    "extraResources": [{"from": "assets/", "to": "assets/"}]
  }
}
